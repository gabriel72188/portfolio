---
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";
import BlackHoleBg from "../components/BlackHoleBg.astro";

interface Props {
  title?: string;
  hasHero?: boolean;
}
const { title = "Gabriel - Web Developer", hasHero = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang = lang === "es" ? "en" : "es";
let altPath =
  lang === "es"
    ? `/en${Astro.url.pathname}`
    : Astro.url.pathname.replace("/en", "") || "/";

if (Astro.url.pathname.endsWith("/verproyectos") || Astro.url.pathname.endsWith("/verproyectos/")) {
  altPath = "/en/seeprojects";
} else if (Astro.url.pathname.endsWith("/seeprojects") || Astro.url.pathname.endsWith("/seeprojects/")) {
  altPath = "/verproyectos";
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Gabriel — Desarrollador Web Frontend especializado en interfaces modernas."
    />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/minilogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --black: #080808;
        --white: #f2f0eb;
        --g1: #141414;
        --g2: #202020;
        --g3: #333333;
        --g4: #555555;
        --g5: #888888;
        --g6: #bbbbbb;
        --D: "Bebas Neue", sans-serif;
        --B: "Outfit", sans-serif;
        --nav: 68px;
        --sp: 110px;
        --lg-bg: rgba(255, 255, 255, 0.04);
        --lg-bg-hover: rgba(255, 255, 255, 0.09);
        --lg-border: rgba(255, 255, 255, 0.14);
        --lg-border-hover: rgba(255, 255, 255, 0.25);
        --lg-shadow:
          inset 0 0 16px rgba(255, 255, 255, 0.025),
          0 16px 40px -8px rgba(0, 0, 0, 0.55);
        --lg-blur: blur(24px) saturate(180%);
        --lg-ease: cubic-bezier(0.16, 1, 0.3, 1);
        /* Oscuridad y desenfoque del fondo sobre el agujero negro en las secciones (sombra desenfoque) */
        --bg-scrim: 0.55;
        --bg-blur: 14px;
      }
      html {
        scroll-behavior: smooth;
        background: #000;
        color: var(--white);
        font-family: var(--B);
      }
      body {
        min-height: 100vh;
        overflow-x: hidden;
        position: relative;
        background: transparent;
      }
      main,
      footer {
        position: relative;
      }
      ::selection {
        background: var(--white);
        color: var(--black);
      }
      ::-webkit-scrollbar {
        width: 3px;
      }
      ::-webkit-scrollbar-track {
        background: var(--black);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--g3);
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        max-width: 100%;
        display: block;
      }
      button {
        cursor: pointer;
        font-family: var(--B);
      }
      .w {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 36px;
      }

      /* reveal */
      .r {
        opacity: 0;
        transform: translateY(22px);
        transition:
          opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .r.v {
        opacity: 1;
        transform: translateY(0);
      }
      .r.d1 {
        transition-delay: 0.1s;
      }
      .r.d2 {
        transition-delay: 0.2s;
      }
      .r.d3 {
        transition-delay: 0.3s;
      }
      .r.d4 {
        transition-delay: 0.4s;
      }

      /* section common */
      .sec {
        padding: var(--sp) 0;
        background: transparent;
      }
      .scrim-layer {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
        pointer-events: none;
        background: rgba(0, 0, 0, var(--bg-scrim));
        backdrop-filter: blur(var(--bg-blur));
        -webkit-backdrop-filter: blur(var(--bg-blur));
      }
      .scrim-layer.with-hero {
        top: 55dvh;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 45dvh, #000 100%);
        mask-image: linear-gradient(to bottom, transparent 0, #000 45dvh, #000 100%);
      }
      .slabel {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #ffac4e;
        margin-bottom: 44px;
      }
      .stitle {
        font-family: var(--D);
        font-size: clamp(3.5rem, 7vw, 6.5rem);
        line-height: 0.92;
        letter-spacing: 0.03em;
        color: var(--white);
      }

      /* shared liquid glass surface */
      .lg-glass {
        background: var(--lg-bg);
        backdrop-filter: var(--lg-blur);
        -webkit-backdrop-filter: var(--lg-blur);
        border: 1px solid var(--lg-border);
        box-shadow: var(--lg-shadow);
      }

      /* buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 42px;
        padding: 0 26px;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-radius: 9999px;
        border: 1px solid transparent;
        transition:
          background 0.25s var(--lg-ease),
          color 0.25s var(--lg-ease),
          border-color 0.25s var(--lg-ease),
          box-shadow 0.25s var(--lg-ease),
          transform 0.25s var(--lg-ease);
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .bP {
        background: var(--white);
        background-clip: padding-box;
        color: var(--black);
        border-color: transparent;
      }
      .bP:hover {
        background: #ffffff;
        box-shadow: 0 8px 24px -6px rgba(255, 235, 205, 0.25);
      }
      .bG {
        background: var(--lg-bg);
        backdrop-filter: blur(18px) saturate(180%);
        -webkit-backdrop-filter: blur(18px) saturate(180%);
        border: 1px solid var(--lg-border);
        box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.45);
        color: rgba(242, 240, 235, 0.85);
      }
      .bG:hover {
        background: var(--lg-bg-hover);
        border-color: var(--lg-border-hover);
        color: var(--white);
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.55);
      }

      @media (max-width: 640px) {
        .w {
          padding: 0 20px;
        }
      }
    </style>
  </head>
  <body>
    <BlackHoleBg />
    <div class:list={["scrim-layer", { "with-hero": hasHero }]} aria-hidden="true"></div>
    <nav id="nb">
      <div class="w ni">
        <button class="mb" id="mbtn" aria-label="Menu" aria-expanded="false">
          <span></span>
          <span></span>
        </button>
        <div class="nls" id="nmenu">
          <a href={`${getLocalePath(lang)}#inicio`}>{t.nav.inicio}</a>
          <a href={`${getLocalePath(lang)}#about`}>{t.nav.about}</a>
          <a href={`${getLocalePath(lang)}#proyectos`}>{t.nav.proyectos}</a>
          <a href={`${getLocalePath(lang)}#contacto`}>{t.nav.contacto}</a>
        </div>
        <a href={altPath} class="lb">{altLang.toUpperCase()}</a>
      </div>
    </nav>

    <main><slot /></main>

    <footer>
      <div class="w fi2">
        <span class="flogo">G.</span>
        <span class="fcopy"
          >&copy; {new Date().getFullYear()} Gabriel — {t.footer}</span
        >
      </div>
    </footer>

    <style>
      nav {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: max-content;
        max-width: calc(100vw - 32px);
        z-index: 200;
        height: 54px;
        border-radius: 9999px;
        background: var(--lg-bg);
        backdrop-filter: var(--lg-blur);
        -webkit-backdrop-filter: var(--lg-blur);
        border: 1px solid var(--lg-border);
        box-shadow: var(--lg-shadow);
        transition:
          background 0.35s var(--lg-ease),
          border-color 0.35s var(--lg-ease),
          box-shadow 0.35s var(--lg-ease),
          transform 0.35s var(--lg-ease);
      }
      nav.sc {
        background: rgba(255, 255, 255, 0.065);
        border-color: rgba(255, 255, 255, 0.18);
        box-shadow: 0 16px 40px -4px rgba(0, 0, 0, 0.65);
      }
      .ni {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 100%;
        padding: 0 10px;
        max-width: none;
        margin: 0;
      }
      .mb {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 38px;
        height: 38px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--lg-border);
        padding: 0;
        transition:
          background 0.25s var(--lg-ease),
          border-color 0.25s var(--lg-ease);
      }
      .mb:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--lg-border-hover);
      }
      .mb span {
        display: block;
        width: 16px;
        height: 1.5px;
        background: var(--white);
        border-radius: 2px;
        transition:
          transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      nav.open .mb span:first-child {
        transform: translateY(3.25px) rotate(45deg);
      }
      nav.open .mb span:last-child {
        transform: translateY(-3.25px) rotate(-45deg);
      }
      .nls {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .nls a {
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(242, 240, 235, 0.75);
        padding: 8px 16px;
        border-radius: 9999px;
        border: 1px solid transparent;
        transition:
          color 0.25s var(--lg-ease),
          background 0.25s var(--lg-ease),
          border-color 0.25s var(--lg-ease);
        position: relative;
      }
      .nls a:hover {
        color: var(--white);
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--lg-border);
      }
      .lb {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: rgba(242, 240, 235, 0.85);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--lg-border);
        padding: 7px 14px;
        border-radius: 9999px;
        transition:
          color 0.25s var(--lg-ease),
          background 0.25s var(--lg-ease),
          border-color 0.25s var(--lg-ease);
      }
      .lb:hover {
        color: var(--white);
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--lg-border-hover);
      }
      footer {
        background: transparent;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        padding: 28px 0;
      }
      .fi2 {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .flogo {
        font-family: var(--D);
        font-size: 1.6rem;
        letter-spacing: 0.04em;
      }
      .fcopy {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--g4);
      }
      @media (max-width: 640px) {
        nav {
          top: 16px;
          width: calc(100vw - 40px);
        }
        .ni {
          padding: 0 10px;
          width: 100%;
          justify-content: space-between;
        }
        .mb {
          display: flex;
        }
        .nls {
          position: absolute;
          top: calc(100% + 10px);
          left: 0;
          right: 0;
          transform: translateY(-8px) scale(0.97);
          flex-direction: column;
          align-items: stretch;
          width: 100%;
          padding: 8px;
          border-radius: 24px;
          background: rgba(20, 20, 20, 0.65);
          backdrop-filter: blur(24px) saturate(180%);
          -webkit-backdrop-filter: blur(24px) saturate(180%);
          border: 1px solid var(--lg-border);
          box-shadow: 0 16px 40px -4px rgba(0, 0, 0, 0.65);
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition:
            opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.28s;
        }
        nav.open .nls {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          transform: translateY(0) scale(1);
        }
        .nls a {
          text-align: center;
          padding: 11px 20px;
        }
        .fi2 {
          flex-direction: column;
          gap: 10px;
          text-align: center;
        }
      }
    </style>

    <script>
      const nb = document.getElementById("nb");
      const mbtn = document.getElementById("mbtn");

      window.addEventListener("scroll", () => {
        nb?.classList.toggle("sc", scrollY > 20);
      });

      mbtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = nb?.classList.toggle("open");
        mbtn.setAttribute("aria-expanded", String(!!isOpen));
      });

      document.querySelectorAll("#nmenu a").forEach((link) => {
        link.addEventListener("click", () => {
          nb?.classList.remove("open");
          mbtn?.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("click", (e) => {
        if (nb?.classList.contains("open") && !nb.contains(e.target as Node)) {
          nb.classList.remove("open");
          mbtn?.setAttribute("aria-expanded", "false");
        }
      });

      const ro = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add("v");
          });
        },
        { threshold: 0.08 },
      );
      document.querySelectorAll(".r").forEach((el) => ro.observe(el));
    </script>
  </body>
</html>
