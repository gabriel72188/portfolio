---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="inicio" class="hero">
  <div class="w hc">
    <h1 class="htitle r d1">GABRIEL</h1>
    <span class="hsub r d2">{t.hero.sub}</span>
    <div class="hrow">
      <div class="hbtns r d3">
        <a href={`${getLocalePath(lang)}#proyectos`} class="btn bP">{t.hero.cta}</a>
        <a href={`${getLocalePath(lang)}#contacto`} class="btn bG">{t.hero.cta2}</a>
      </div>
    </div>
    <div class="hscroll r" style="transition-delay:.5s">
      <div class="stk"></div>
      <span class="slbl">scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .hc {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: calc(var(--nav) + 40px);
    padding-bottom: clamp(32px, 5vh, 56px);
  }
  .htitle {
    font-family: var(--D);
    font-size: clamp(4.2rem, 9.5vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--white);
  }
  .hsub {
    font-family: var(--D);
    font-size: clamp(1.75rem, 3.8vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--g4);
    display: block;
    margin-bottom: 0;
  }
  .hrow {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    margin-top: 24px;
  }
  .hbtns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .hscroll {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }
  .stk {
    width: 36px;
    height: 1px;
    background: var(--g3);
    overflow: hidden;
    position: relative;
  }
  .stk::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--white);
    animation: rn 2.2s ease-in-out infinite;
  }
  @keyframes rn {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
  }
  .slbl {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--g5);
  }
</style>
